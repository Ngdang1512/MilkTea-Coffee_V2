 usecase "UC07\nThêm khách tại quầy" as U7
 usecase "UC08\nTìm kiếm khách hàng" as U8
 usecase "UC09\nKhóa hoặc mở khóa khách" as U9
 usecase "UC10\nXóa khách hàng" as U10
 usecase "UC11\nTiếp nhận phản hồi" as U11
 usecase "UC12\nBáo cáo khách hàng" as U12
}
S -- U7
S -- U8
S -- U11
M -- U7
M -- U8
M -- U9
M -- U10
M -- U11
M -- U12

@enduml
